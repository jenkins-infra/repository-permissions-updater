<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Scopes">
    <f:repeatable field="scopes" header="Scope">
      <f:textbox field="name"/>
      <f:repeatableDeleteButton/>
    </f:repeatable>
  </f:entry>
  <f:entry title="Servers">
    <f:repeatableProperty field="servers" header="Server"/>
  </f:entry>
</j:jelly>
